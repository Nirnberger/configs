[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
[merge]
	conflictStyle = zdiff3
[alias]
	lg = log --oneline --graph --decorate -20
	st = status -sb
	amend = commit --amend --no-edit
	undo = reset --soft HEAD~1
	unstage = restore --staged
	last = show --stat HEAD
	fixup = commit --fixup
