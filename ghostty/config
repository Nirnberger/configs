# Same look and behaviour as alacritty/alacritty.toml

font-family = JetBrainsMono Nerd Font Mono
font-style = Medium
font-style-italic = Medium Italic
font-style-bold-italic = ExtraBold Italic
font-size = 15

window-padding-x = 25
window-padding-y = 20
macos-titlebar-style = hidden

# plain xterm: servers reached over ssh don't know xterm-ghostty
term = xterm-256color

# zsh starts tmux with exec, so a detach closes the window; the app goes with it
quit-after-last-window-closed = true

# macos-option-as-alt stays off: on the German layout ⌥5 and ⌥6 type [ and ]

keybind = cmd+q=ignore
keybind = cmd+w=ignore

# Tokyo Night Storm
background = #24283b
foreground = #a9b1d6
palette = 0=#32344a
palette = 1=#f7768e
palette = 2=#9ece6a
